; Engine configuration file for PROJECT GRAVITY (Godot 4.x)
; Primary language: GDScript 2.x Strict (ADR-0001)

config_version=5

[application]

config/name="PROJECT GRAVITY"
config/description="AI-Native Multiplayer First Component-Based Architecture"
run/main_scene="res://scenes/sandbox_test_scene.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
viewport/transparent_background=false
